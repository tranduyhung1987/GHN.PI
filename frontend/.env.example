# GHN.PI - Environment Variables Example (for Cloudflare Pages)
# Copy file này thành .env (local development only) và điền giá trị thật
#
# QUAN TRỌNG: Trong production (Cloudflare Pages), BẮT BUỘC phải đặt các biến này
# tại: Cloudflare Dashboard → Pages → ghn-pi → Settings → Environment variables

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Pi Network (nếu cần sau này)
# VITE_PI_API_URL=https://api.minepi.com

# ==================== ADMIN CONFIG (Phương án 1 - Hardcode) ====================
# Chỉ những Pi username trong danh sách này mới được tự động gán quyền Admin.
# Phân cách bằng dấu phẩy. KHÔNG có dấu @ ở đầu username.
#
# Ví dụ: VITE_ADMIN_USERNAMES=nguyenhoi123455,anotheradmin
#
# Trong môi trường development, bạn cũng có thể override bằng:
# localStorage.setItem('devAdminUsernames', 'nguyenhoi123455')
#
# QUAN TRỌNG:
# - Trong Cloudflare Pages: Thêm biến này ở Settings → Environment variables
# - Local: Copy file này thành .env và điền giá trị thật
VITE_ADMIN_USERNAMES=nguyenhoi123455
