# GHN.PI - Environment Variables Example (for Cloudflare Pages)
# Copy file này thành .env (local development only) và điền giá trị thật
#
# QUAN TRỌNG: Trong production (Cloudflare Pages), BẮT BUỘC phải đặt các biến này
# tại: Cloudflare Dashboard → Pages → ghn-pi → Settings → Environment variables

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Pi Network (nếu cần sau này)
# VITE_PI_API_URL=https://api.minepi.com
